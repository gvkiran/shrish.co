rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'contact@shrish.co';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function newOrderCustomerIsValid() {
      return !request.resource.data.keys().hasAny(['customerUid'])
        || (
          isSignedIn()
          && request.resource.data.customerUid == request.auth.uid
        );
    }

    function newWebsiteOrderIsValid() {
      return request.resource.data.keys().hasAll([
          'firstName',
          'lastName',
          'email',
          'phoneDigits',
          'fulfillmentType',
          'paymentMethod',
          'paymentStatus',
          'status',
          'items',
          'source',
          'websiteFinalizationState',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNumber',
          'firstName',
          'lastName',
          'fullName',
          'phone',
          'phoneDigits',
          'email',
          'fulfillmentType',
          'fulfillmentLabel',
          'location',
          'locationLabel',
          'pickupLocation',
          'pickupLocationLabel',
          'shippingAddress',
          'referral',
          'attribution',
          'notes',
          'items',
          'totalBoxes',
          'itemSubtotal',
          'salesTaxState',
          'salesTaxLabel',
          'salesTaxRate',
          'salesTaxAmount',
          'shippingLabel',
          'shippingAmount',
          'shippingFreeThreshold',
          'totalPrice',
          'promoCode',
          'promoType',
          'promoDiscount',
          'promoFreeShipping',
          'payment',
          'paymentMethod',
          'paymentMethodLabel',
          'paymentStatus',
          'saveCardRequested',
          'status',
          'source',
          'skipCustomerEmail',
          'websiteFinalizationState',
          'customerUid',
          'customerEmail',
          'createdAt',
          'updatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['attribution']) || request.resource.data.attribution is map)
        && request.resource.data.source == 'website'
        && request.resource.data.websiteFinalizationState == 'unverified'
        && request.resource.data.orderNumber == ''
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() >= 1
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phoneDigits is string
        && request.resource.data.phoneDigits.matches('^[0-9]{10,11}$')
        && request.resource.data.fulfillmentType in ['pickup', 'shipping']
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 40
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.paymentMethod == 'stripe'
            && request.resource.data.paymentStatus == 'awaiting_payment'
            && request.resource.data.status == 'awaiting_payment'
            && request.resource.data.skipCustomerEmail == true
          )
          || (
            request.resource.data.paymentMethod == 'pay_at_pickup'
            && request.resource.data.paymentStatus == 'pay_at_pickup'
            && request.resource.data.status == 'pending'
          )
        );
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Offline sales: booth, WhatsApp, phone, and the admin manual order form.
    // These live in `orders` alongside website sales so revenue, lifetime value
    // and CRM segments stay correct without unioning two schemas. `source` is
    // the discriminator, so they remain trivially filterable and auditable.
    //
    // This is not a privilege escalation: isAdmin() already permits unrestricted
    // update and delete on every order below. Create was the only missing verb,
    // which is why the existing "+ Manual Order" form silently failed.
    function newAdminOfflineOrderIsValid() {
      return isAdmin()
        && request.resource.data.source in ['booth', 'whatsapp', 'phone', 'market', 'referral', 'admin_manual']
        && request.resource.data.phoneDigits is string
        && request.resource.data.phoneDigits.size() <= 15
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 60
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice >= 0
        && request.resource.data.totalPrice <= 100000
        && request.resource.data.skipCustomerEmail == true;
    }

    match /orders/{orderId} {
      allow create: if (
          orderId.matches('^[A-Za-z0-9]{20}$')
          && newOrderCustomerIsValid()
          && newWebsiteOrderIsValid()
        ) || newAdminOfflineOrderIsValid();
      allow get: if isAdmin()
        || (
          isSignedIn()
          && resource.data.customerUid == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          isSignedIn()
          && resource.data.customerUid == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    // CRM overlay keyed on phoneDigits. Holds only annotations the owner adds
    // by hand — tags and notes. Order data itself is never copied here, so
    // `orders` stays the single source of truth with nothing to keep in sync.
    // Owner-only in both directions; no customer ever reads or writes this.
    match /crm_customers/{customerKey} {
      allow read, write: if isAdmin();
    }

    // Marketing suppression list and campaign log. Opt-outs are written only by
    // the unsubscribeEmail function using the Admin SDK, which bypasses these
    // rules, so no client path can add or remove a suppression.
    match /email_optouts/{optOutId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /crm_campaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /order_feedback/{feedbackId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /refund_requests/{docId} {
      allow get, list: if isAdmin();
      allow create: if docId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /promo_codes/{code} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /promo_redemptions/{id} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /order_locks/{phoneDigits} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /_security_rate_limits/{bucketId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /notify_requests/{docId} {
      allow get, list: if isAdmin();
      allow create: if docId.matches('^[A-Za-z0-9]{20}$');
      allow update, delete: if isAdmin();
    }

    match /email_subscribers/{emailId} {
      allow get, list: if isAdmin();
      allow create: if emailId.matches('^[A-Za-z0-9]{20}$');
      allow update, delete: if isAdmin();
    }

    match /accounting_batches/{batchId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /ad_metrics_meta/{docId} {
      allow get, list: if isAdmin();            // admin dashboard reads synced Meta ad metrics
      allow create, update, delete: if false;   // written only by the sync job via Admin SDK
    }
  }
}
