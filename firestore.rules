rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'contact@shrish.co';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function newOrderCustomerIsValid() {
      return !request.resource.data.keys().hasAny(['customerUid'])
        || (
          isSignedIn()
          && request.resource.data.customerUid == request.auth.uid
        );
    }

    function newWebsiteOrderIsValid() {
      return request.resource.data.keys().hasAll([
          'firstName',
          'lastName',
          'email',
          'phoneDigits',
          'fulfillmentType',
          'paymentMethod',
          'paymentStatus',
          'status',
          'items',
          'source',
          'websiteFinalizationState',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNumber',
          'firstName',
          'lastName',
          'fullName',
          'phone',
          'phoneDigits',
          'email',
          'fulfillmentType',
          'fulfillmentLabel',
          'location',
          'locationLabel',
          'pickupLocation',
          'pickupLocationLabel',
          'shippingAddress',
          'referral',
          'notes',
          'items',
          'totalBoxes',
          'itemSubtotal',
          'salesTaxState',
          'salesTaxLabel',
          'salesTaxRate',
          'salesTaxAmount',
          'shippingLabel',
          'shippingAmount',
          'shippingFreeThreshold',
          'totalPrice',
          'promoCode',
          'promoType',
          'promoDiscount',
          'promoFreeShipping',
          'payment',
          'paymentMethod',
          'paymentMethodLabel',
          'paymentStatus',
          'saveCardRequested',
          'status',
          'source',
          'skipCustomerEmail',
          'websiteFinalizationState',
          'customerUid',
          'customerEmail',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.source == 'website'
        && request.resource.data.websiteFinalizationState == 'unverified'
        && request.resource.data.orderNumber == ''
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() >= 1
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phoneDigits is string
        && request.resource.data.phoneDigits.matches('^[0-9]{10,11}$')
        && request.resource.data.fulfillmentType in ['pickup', 'shipping']
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 40
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.paymentMethod == 'stripe'
            && request.resource.data.paymentStatus == 'awaiting_payment'
            && request.resource.data.status == 'awaiting_payment'
            && request.resource.data.skipCustomerEmail == true
          )
          || (
            request.resource.data.paymentMethod == 'pay_at_pickup'
            && request.resource.data.paymentStatus == 'pay_at_pickup'
            && request.resource.data.status == 'pending'
          )
        );
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if orderId.matches('^[A-Za-z0-9]{20}$')
        && newOrderCustomerIsValid()
        && newWebsiteOrderIsValid();
      allow get: if isAdmin()
        || (
          isSignedIn()
          && resource.data.customerUid == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          isSignedIn()
          && resource.data.customerUid == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /order_feedback/{feedbackId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /refund_requests/{docId} {
      allow get, list: if isAdmin();
      allow create: if docId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /promo_codes/{code} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /promo_redemptions/{id} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /order_locks/{phoneDigits} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /_security_rate_limits/{bucketId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /notify_requests/{docId} {
      allow get, list: if isAdmin();
      allow create: if docId.matches('^[A-Za-z0-9]{20}$');
      allow update, delete: if isAdmin();
    }

    match /email_subscribers/{emailId} {
      allow get, list: if isAdmin();
      allow create: if emailId.matches('^[A-Za-z0-9]{20}$');
      allow update, delete: if isAdmin();
    }

    match /accounting_batches/{batchId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /ad_metrics_meta/{docId} {
      allow get, list: if isAdmin();            // admin dashboard reads synced Meta ad metrics
      allow create, update, delete: if false;   // written only by the sync job via Admin SDK
    }
  }
}
